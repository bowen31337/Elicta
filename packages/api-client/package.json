{
  "name": "api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client generated from the service tier's OpenAPI schema. Do not hand-edit — regenerate with `pnpm --filter api-client generate`.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  }
}
