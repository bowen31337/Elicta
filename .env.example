# claw-forge environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Every variable below is marked REQUIRED or OPTIONAL. REQUIRED variables
# must be set for the corresponding process to start; a process that is
# missing one fails at startup with an error naming the missing variable(s)
# rather than failing later with an unrelated error. See docs/RUNBOOK.md for
# the full reference table and the startup-validation contract.

# ── Anthropic (direct) ────────────────────────────────────────────────────────
# REQUIRED (claw-forge CLI, and apps/service's Claude Agent SDK-based context
# compiler / debrief engine — architecture "Deployment", §9). API key from
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — alternate apps/service auth path. Architecture §9 notes Bedrock
# and Vertex authentication are supported "via environment variables" as a
# route back to in-tenant inference; set one of CLAUDE_CODE_USE_BEDROCK=1 or
# CLAUDE_CODE_USE_VERTEX=1 (plus the corresponding AWS/GCP credentials, per
# the Claude Agent SDK docs) to authenticate that way instead of
# ANTHROPIC_API_KEY. Exactly one auth path is required by apps/service; this
# is not required in addition to ANTHROPIC_API_KEY.
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# ── Model aliases (override defaults without editing claw-forge.yaml) ─────────
# OPTIONAL — all default if unset.
# MODEL_DEFAULT=claude-sonnet-4-6
# MODEL_OPUS=claude-opus-4-6
# MODEL_SONNET=claude-sonnet-4-6
# MODEL_HAIKU=claude-haiku-4-6
# MODEL_FAST=claude-haiku-4-6

# ── Anthropic OAuth (Claude.ai / claude CLI) ──────────────────────────────────
# OPTIONAL — alternate to ANTHROPIC_API_KEY for the claw-forge CLI only.
# Run `claude setup-token` to get this token, then paste it here.
# ANTHROPIC_OAUTH_TOKEN=...
# ANTHROPIC_OAUTH_MODEL=claude-sonnet-4-6

# ── Anthropic-compatible proxy ────────────────────────────────────────────────
# OPTIONAL. Any provider that speaks the Anthropic Messages API (e.g.
# internal gateways).
# PROXY_API_KEY=...
# PROXY_BASE_URL=https://your-proxy.example.com/api/anthropic
# PROXY_MODEL=claude-sonnet-4-6

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPTIONAL.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── OpenAI-compatible proxy (e.g. Azure, Together, Fireworks) ─────────────────
# OPTIONAL.
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://...
# OPENAI_COMPAT_MODEL=...

# ── Groq ──────────────────────────────────────────────────────────────────────
# OPTIONAL.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Cerebras ──────────────────────────────────────────────────────────────────
# OPTIONAL.
# CEREBRAS_API_KEY=...
# CEREBRAS_MODEL=llama3.3-70b

# ── Ollama (local) ────────────────────────────────────────────────────────────
# OPTIONAL.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:32b

# ── Service tier database ────────────────────────────────────────────────
# Postgres URL used by `apps/service` and by `alembic upgrade`. The driver
# must be asyncpg: the service and the migration harness both connect
# asynchronously.
#   uv run --project apps/service alembic upgrade head
# Offline SQL rendering (`--sql`) needs no reachable database, so CI
# validates the migration chain without one.
DATABASE_URL=postgresql+asyncpg://localhost/elicta

# ── Inference (context compiler + debrief pipeline, ADR-012) ─────────────
# NOTE: these are a FALLBACK for headless deployments. The operator-facing
# route is the desktop app's Settings screen, which writes to the service's
# settings store — a value set there wins over anything here, and takes
# effect without a restart. Set these only where no operator is at a screen.
# With none of ANTHROPIC_API_KEY / CLAUDE_CODE_USE_BEDROCK /
# CLAUDE_CODE_USE_VERTEX set, the service still starts and serves its full
# API; the pipeline stages that need a model persist a FAILED record naming
# the missing setting instead of fabricating output.
# ELICTA_INFERENCE_MODEL overrides the model used for those stages.
ELICTA_INFERENCE_MODEL=claude-opus-5
