# claw-forge environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Every variable below is marked REQUIRED or OPTIONAL. REQUIRED variables
# must be set for the corresponding process to start; a process that is
# missing one fails at startup with an error naming the missing variable(s)
# rather than failing later with an unrelated error. See docs/RUNBOOK.md for
# the full reference table and the startup-validation contract.

# ── Anthropic (direct) ────────────────────────────────────────────────────────
# REQUIRED (claw-forge CLI, and apps/service's Claude Agent SDK-based context
# compiler / debrief engine — architecture "Deployment", §9). API key from
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — alternate apps/service auth path. Architecture §9 notes Bedrock
# and Vertex authentication are supported "via environment variables" as a
# route back to in-tenant inference; set one of CLAUDE_CODE_USE_BEDROCK=1 or
# CLAUDE_CODE_USE_VERTEX=1 (plus the corresponding AWS/GCP credentials, per
# the Claude Agent SDK docs) to authenticate that way instead of
# ANTHROPIC_API_KEY. Exactly one auth path is required by apps/service; this
# is not required in addition to ANTHROPIC_API_KEY.
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# ── Model aliases (override defaults without editing claw-forge.yaml) ─────────
# OPTIONAL — all default if unset.
# MODEL_DEFAULT=claude-sonnet-4-6
# MODEL_OPUS=claude-opus-4-6
# MODEL_SONNET=claude-sonnet-4-6
# MODEL_HAIKU=claude-haiku-4-6
# MODEL_FAST=claude-haiku-4-6

# ── Anthropic OAuth (Claude.ai / claude CLI) ──────────────────────────────────
# OPTIONAL — alternate to ANTHROPIC_API_KEY for the claw-forge CLI only.
# Run `claude setup-token` to get this token, then paste it here.
# ANTHROPIC_OAUTH_TOKEN=...
# ANTHROPIC_OAUTH_MODEL=claude-sonnet-4-6

# ── Anthropic-compatible proxy ────────────────────────────────────────────────
# OPTIONAL. Any provider that speaks the Anthropic Messages API (e.g.
# internal gateways).
# PROXY_API_KEY=...
# PROXY_BASE_URL=https://your-proxy.example.com/api/anthropic
# PROXY_MODEL=claude-sonnet-4-6

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPTIONAL.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── OpenAI-compatible proxy (e.g. Azure, Together, Fireworks) ─────────────────
# OPTIONAL.
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://...
# OPENAI_COMPAT_MODEL=...

# ── Groq ──────────────────────────────────────────────────────────────────────
# OPTIONAL.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Cerebras ──────────────────────────────────────────────────────────────────
# OPTIONAL.
# CEREBRAS_API_KEY=...
# CEREBRAS_MODEL=llama3.3-70b

# ── Ollama (local) ────────────────────────────────────────────────────────────
# OPTIONAL.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:32b

# ── Service tier database ────────────────────────────────────────────────
# OPTIONAL, and deliberately left unset. Elicta keeps everything in a SQLite
# file under ELICTA_STATE_DIR (or ~/.elicta) unless told otherwise, because the
# desktop product ships to people with no database server. Setting this here
# opts the whole deployment onto PostgreSQL — which is why it is commented out:
# copying this file to `.env` with it live would point a laptop at a server
# that is not there, and the SQLite default would never apply.
#
# The Settings screen writes the same value as a write-only secret and
# overrides this; either route takes effect on restart. The migration harness
# wants the asyncpg driver, and the service strips that marker for its own
# synchronous access.
#   uv run --project apps/service alembic upgrade head
# Offline SQL rendering (`--sql`) needs no reachable database, so CI
# validates the migration chain without one.
# DATABASE_URL=postgresql+asyncpg://localhost/elicta

# ── Inference (context compiler + debrief pipeline, ADR-012) ─────────────
# NOTE: these are a FALLBACK for headless deployments. The operator-facing
# route is the desktop app's Settings screen, which writes to the service's
# settings store — a value set there wins over anything here, and takes
# effect without a restart. Set these only where no operator is at a screen.
# With none of ANTHROPIC_API_KEY / CLAUDE_CODE_USE_BEDROCK /
# CLAUDE_CODE_USE_VERTEX set, the service still starts and serves its full
# API; the pipeline stages that need a model persist a FAILED record naming
# the missing setting instead of fabricating output.
# ELICTA_INFERENCE_MODEL chooses the model for those stages until somebody
# saves one on the Settings screen, after which the saved value wins. Worth
# setting deliberately: a credential that cannot reach the chosen model is
# refused with a 429 carrying no retry-after, which reads like throttling and
# never clears.
ELICTA_INFERENCE_MODEL=claude-opus-5
# Either credential works. ANTHROPIC_API_KEY authenticates as X-Api-Key;
# ANTHROPIC_AUTH_TOKEN (or ANTHROPIC_OAUTH_TOKEN) authenticates as a bearer
# token from `claude setup-token`. The Settings screen selects which is live.
# ANTHROPIC_AUTH_TOKEN=...

# ── Microsoft 365 documents (SharePoint, OneDrive, Teams) ────────────────
# OPTIONAL — headless fallback for the reference-document connector; the
# Settings screen is the normal way in, and a UI-set value overrides these.
# Without them a link can still be recorded nowhere: attaching one is refused
# with a message naming the missing setting, because a document Elicta cannot
# read contributes nothing to the question bank and used to do so silently.
# Uploading a file needs none of this.
#
# An Entra ID app registration with application permissions Files.Read.All,
# and Sites.Read.All for team sites. Client credentials rather than a pasted
# access token, which expires within the hour.
# ELICTA_GRAPH_TENANT_ID=...
# ELICTA_GRAPH_CLIENT_ID=...
# ELICTA_GRAPH_CLIENT_SECRET=...

# ── Record-path speech vendors ──────────────────────────────────────────
# OPTIONAL — headless fallback for the record-path ASR engines; the Settings
# screen is the normal way in, and a UI-set value overrides these.
# Two engines run over every recording (FR-2.6) and they are independent
# vendors, so each needs its own key. A key set on the Settings screen
# overrides the value here.
# ELICTA_DEEPGRAM_API_KEY=
# ELICTA_ASSEMBLYAI_API_KEY=

# ── Settings storage ─────────────────────────────────────────────────────
# Where operator-administered settings persist. Secret values in this file
# are encrypted; ELICTA_SETTINGS_KEY holds the key (a 0600 file beside the
# database is generated if unset). Point the key at a KMS or mounted secret
# in a managed deployment.
# ELICTA_SETTINGS_DB=/var/lib/elicta/settings.db
# ELICTA_SETTINGS_KEY=...
