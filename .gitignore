coverage/
# `coverage/` above targets test-coverage report output, but also matches
# the desktop panel's coverage feature directory and the coverage-tracker
# crate by name -- un-ignore them.
!apps/desktop/src/features/panel/coverage/
!core/crates/coverage/
# Page images from handbook/tools/preview.sh — a local convenience for
# editors that render images but not PDFs. The PDF itself IS committed.
handbook/preview/

*.log
*.bak
*.tmp
*.orig

# Downloaded release bundles (.dmg / .msi pulled from a CI run for hand
# testing). Build output, not source — the canonical copies live on the
# GitHub Release and the workflow artifact.
/release/

# Video, anywhere. A recording is regenerable evidence of one run on one
# machine, it is large, and git cannot prune it later without rewriting
# history. Nothing in this repository reads a video: the handbook embeds
# stills, and the journey reports are text.
*.mp4

# Screenshots from a live journey run (tests/e2e/journeys/live-run.mjs), for
# the same reasons -- but scoped to that directory rather than global, and the
# asymmetry is deliberate: the handbook embeds docs/journeys/screenshots/*.png
# by name, so a bare *.png rule would silently swallow the whole set and the
# PDF would build without pictures.
docs/journeys/live-run/**/*.png

# The state database one fixture-driven end-to-end run writes for itself
# (tests/e2e/fixture_run/run.py). Scratch by design: the run builds the whole
# engagement from the fixtures every time, so a committed copy could only ever
# be a stale duplicate of what the code already says.
tests/e2e/fixture_run/.state/

# Autonomous agent loop state (scripts/ralph). prd.json and the scripts are
# the inputs and are committed; progress.txt, handoff.json and the archives
# are per-run scratch written by the loop itself.
scripts/ralph/progress.txt
scripts/ralph/handoff.json
scripts/ralph/.last-branch
scripts/ralph/archive/

# Self-signed certificates generated by `start.sh --https` for local testing.
.certs/

# Worktrees created for isolated task execution.
.claude/worktrees/
